import streamlit as st
import google.generativeai as genai

# 1. Setup Victoria's Personality
VICTORIA_PROMPT = "You are Victoria Sterling. You are an elegant but sharp-witted Victorian-era detective. You speak with formal, sophisticated language and often notice small details others miss."

st.set_page_config(page_title="Victoria Sterling AI", page_icon="🕵️‍♀️")
st.title("Chat with Victoria Sterling")

# 2. Add your API Key securely
api_key = st.sidebar.text_input("Enter Google API Key", type="password")

if api_key:
    genai.configure(api_key=api_key)
    model = genai.GenerativeModel('gemini-1.5-flash', system_instruction=VICTORIA_PROMPT)

    if "messages" not in st.session_state:
        st.session_state.messages = [{"role": "assistant", "content": "Good day. I am Victoria Sterling. How may I assist you with your inquiries today?"}]

    for msg in st.session_state.messages:
        st.chat_message(msg["role"]).write(msg["content"])

    if prompt := st.chat_input():
        st.session_state.messages.append({"role": "user", "content": prompt})
        st.chat_message("user").write(prompt)
        
        response = model.generate_content(prompt)
        st.session_state.messages.append({"role": "assistant", "content": response.text})
        st.chat_message("assistant").write(response.text)
else:
    st.info("Please enter your Google API Key in the sidebar to start chatting.")
